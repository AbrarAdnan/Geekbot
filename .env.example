# Copy to `.env` (git-ignored) and edit. Every variable is optional; the values shown are the
# defaults, except where a line says otherwise. See src/geekbot/config.py.

# Which model set to use (D-042, D-043):
#   proto  = gemma3:4b + qwen2.5-coder:3b   (default; fast, for building)
#   target = gemma4:12b + qwen2.5-coder:7b  (the only source of reported numbers)
GEEKBOT_PROFILE=proto

# Override one model regardless of the profile (leave unset to use the profile's).
# GEEKBOT_CHAT_MODEL=gemma4:12b
# GEEKBOT_CSV_MODEL=qwen2.5-coder:7b

GEEKBOT_OLLAMA_HOST=http://127.0.0.1:11434
# The answer graph (step S3.1). Starting values, not measurements.
#   GEEKBOT_CHAT_NUM_PREDICT: the longest reply, in tokens.
#   GEEKBOT_CHAT_THINK_NUM_PREDICT: the same cap when `ask --think` is on (step S3.3): the model's
#     reasoning is generated tokens too, so it needs more room.
#   GEEKBOT_CHAT_TEMPERATURE: 0 is the most repeatable, higher is more varied.
#   GEEKBOT_CONTEXT_BUDGET_TOKENS: how much of the prompt the retrieved sources may take.
# Conversation memory (step S3.4). Starting values, not measurements.
#   GEEKBOT_HISTORY_BUDGET_TOKENS: how much of the prompt the earlier turns of a thread may take.
#   GEEKBOT_HISTORY_KEEP_MESSAGES: how many messages a thread remembers (older ones are forgotten).
#   GEEKBOT_CONDENSE_NUM_PREDICT: the cap on the call that turns a follow-up into a full question.
# GEEKBOT_HISTORY_BUDGET_TOKENS=1000
# GEEKBOT_HISTORY_KEEP_MESSAGES=40
# GEEKBOT_CONDENSE_NUM_PREDICT=96
# GEEKBOT_CHAT_NUM_PREDICT=512
# GEEKBOT_CHAT_THINK_NUM_PREDICT=2048
# GEEKBOT_CHAT_TEMPERATURE=0.2
# GEEKBOT_CONTEXT_BUDGET_TOKENS=3000
# The server (steps S4.1 and S4.2). `geekbot serve` listens on 127.0.0.1 only.
#   GEEKBOT_SERVER_PORT: the port `geekbot serve` listens on.
#   GEEKBOT_ANSWER_TOP_K: how many chunks the server's answer route asks retrieval for.
# GEEKBOT_SERVER_PORT=8000
# GEEKBOT_ANSWER_TOP_K=5
# CSV mode (step C2). Seconds. Unmeasured starting values; step C3 checks them.
#   GEEKBOT_CSV_LLM_TIMEOUT_S: how long to wait for one Ollama call.
#   GEEKBOT_CSV_QUESTION_TIME_LIMIT_S: soft cap per question, checked before each attempt, so a
#   question can run up to this plus one call.
GEEKBOT_CSV_LLM_TIMEOUT_S=60
GEEKBOT_CSV_QUESTION_TIME_LIMIT_S=60

GEEKBOT_DATA_DIR=data
# DEBUG | INFO | WARNING | ERROR | CRITICAL
GEEKBOT_LOG_LEVEL=INFO

# The server's perimeter (step S4.3). Never commit a real value.
#   GEEKBOT_API_KEY: a LOCAL password between `geekbot serve` and the UI, not the key of any cloud
#     service (Geekbot calls none, and this is never sent anywhere). Every request to the server must
#     send it (Authorization: Bearer ...), except /healthz. Leave it unset and `geekbot serve` makes a random one the first time and keeps
#     it in <data folder>/api-key; the UI reads the same place. Set it only to choose your own: at
#     least 24 characters from A-Z a-z 0-9 . _ ~ + / = -
#   GEEKBOT_ALLOWED_ROOTS: folders the server may ingest from by path, besides its own uploads
#     folder (<data folder>/uploads). Full paths, separated by ";" on Windows (":" elsewhere). Empty
#     means: only files uploaded to the server. Write it WITHOUT quotes: inside double quotes a
#     backslash sequence is interpreted (C:\notes would contain a line break). The data folder
#     itself is never readable, even inside one of these.
# GEEKBOT_API_KEY=
# GEEKBOT_ALLOWED_ROOTS=C:\Work\Geekbot\evals;D:\Papers
